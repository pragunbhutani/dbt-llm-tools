# Supabase - Local Development (from `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM Providers (set whichever you plan to use)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# Canonical app URL — set this in production so webhook/callback URLs are correct.
# On Vercel this is optional (VERCEL_URL is auto-injected); on self-hosted installs set it explicitly.
# NEXT_PUBLIC_APP_URL=https://ragstar.mycompany.com

# GitHub OAuth (required for connecting private GitHub repos)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional: passwordless local admin entry with next dev + local Supabase only.
# Prefer pnpm dev:local, which supplies local Supabase credentials automatically.
# DEV_AUTH_BYPASS=true
